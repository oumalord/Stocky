{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "angular",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/stockpilot-web/browser",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://backend-url-not-set.invalid/api/:path*" },
    { "source": "/health/", "destination": "https://backend-url-not-set.invalid/health/" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ]
}
