# Copy to .env and change values. Never commit .env (it is gitignored).
# docker compose loads .env automatically; for plain `manage.py`, set these as shell variables instead.

# Django (backend/config/settings/base.py, prod.py)
DJANGO_SECRET_KEY=X4Z_zb6XpQQfxtPh9kq1uNKK816m_81AEnksaQBkUaJyd0HLU7uXuZhV-LFRYhOsEcVRmDGpPw-4jSr3ldX08g
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:4200
CSRF_TRUSTED_ORIGINS=http://localhost:4200
SECURE_SSL_REDIRECT=true

# Database. If DATABASE_URL is set it wins over POSTGRES_* below.
# Neon: use the direct host (no "-pooler") for migrations, the pooled host on Vercel.
# Leave empty for Docker Compose, which uses the local `db` service.
DATABASE_URL=
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Local PostgreSQL (docker-compose.yml; used when DATABASE_URL is empty)
POSTGRES_DB=stockpilot
POSTGRES_USER=stockpilot
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Set to 1 for quick local runs without PostgreSQL; takes priority over DATABASE_URL.
USE_SQLITE=

# Celery broker (not used on Vercel)
REDIS_URL=redis://localhost:6379/0

# Read only by `manage.py create_org_admin`; set it in your shell rather than storing it here.
# STOCKPILOT_ADMIN_PASSWORD=
